<mxfile host="Electron">
  <diagram id="three-layer-architecture" name="Three-Layer Swarm Quadrotor Architecture">
    <mxGraphModel dx="800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="980" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- INPUT BOX -->
        <mxCell id="input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#2C3E50;" value="&lt;b&gt;Region Input:&lt;/b&gt; Non-Convex Boundary &amp;amp; Initial Drone Poses $$ (p_i^0, N) $$" vertex="1">
          <mxGeometry height="36" width="680" x="40" y="30" as="geometry" />
        </mxCell>

        <!-- DRONE N (STACKED BACKMOST) -->
        <mxCell id="drone_n" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDC3C7;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Times New Roman,Times,serif;fontSize=10;fontColor=#7F8C8D;" value="&lt;i&gt;Drone N&lt;/i&gt;" vertex="1">
          <mxGeometry height="540" width="656" x="64" y="82" as="geometry" />
        </mxCell>

        <!-- DRONE 2 (STACKED MIDDLE) -->
        <mxCell id="drone_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#95A5A6;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Times New Roman,Times,serif;fontSize=10;fontColor=#7F8C8D;" value="&lt;i&gt;Drone 2&lt;/i&gt;" vertex="1">
          <mxGeometry height="540" width="656" x="52" y="90" as="geometry" />
        </mxCell>

        <!-- DRONE 1 (MAIN AGENT CONTAINER) -->
        <mxCell id="drone_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#34495E;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#1C2833;" value="&lt;b&gt;Drone $$i$$ (Local Swarm Agent)&lt;/b&gt;" vertex="1">
          <mxGeometry height="540" width="656" x="40" y="98" as="geometry" />
        </mxCell>

        <!-- HIGH-LEVEL LAYER CONTAINER -->
        <mxCell id="hl_layer" parent="drone_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#1A5276;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#1A5276;" value="&lt;b&gt;HIGH-LEVEL LAYER — Coverage Planning &amp;amp; Resilience&lt;/b&gt;" vertex="1">
          <mxGeometry height="145" width="620" x="18" y="28" as="geometry" />
        </mxCell>

        <!-- Voronoi Block -->
        <mxCell id="voronoi" parent="hl_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=1.5;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#1A5276;" value="&lt;b&gt;Voronoi Partitioning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #2C3E50;&quot;&gt;Non-Convex Sub-Regions&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="160" x="20" y="36" as="geometry" />
        </mxCell>

        <!-- Boustrophedon Block -->
        <mxCell id="boustro" parent="hl_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=1.5;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#1A5276;" value="&lt;b&gt;Boustrophedon Planner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #2C3E50;&quot;&gt;Sweeping Coverage Paths&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="160" x="230" y="36" as="geometry" />
        </mxCell>

        <!-- FT-CC Block -->
        <mxCell id="ftcc" parent="hl_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=1.5;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#1A5276;" value="&lt;b&gt;FT-CC Module&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #2C3E50;&quot;&gt;Fault-Tolerant Coverage&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="160" x="440" y="36" as="geometry" />
        </mxCell>

        <!-- High-level arrows -->
        <mxCell id="edge_v_b" edge="1" parent="hl_layer" source="voronoi" style="endArrow=classic;html=1;strokeColor=#1A5276;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="boustro" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry" />
        </mxCell>

        <mxCell id="edge_b_f" edge="1" parent="hl_layer" source="boustro" style="endArrow=classic;html=1;strokeColor=#1A5276;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="ftcc" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry" />
        </mxCell>

        <!-- Heartbeat Timeout Curved Arrow -->
        <mxCell id="edge_heartbeat" edge="1" parent="hl_layer" source="ftcc" style="endArrow=classic;html=1;dashed=1;strokeColor=#1A5276;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;curved=1;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#1A5276;" target="voronoi" value="&lt;i&gt;heartbeat timeout (re-partition)&lt;/i&gt;">
          <mxGeometry relative="1" x="0.05" y="-10" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="310" y="10" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- MID-LEVEL LAYER CONTAINER -->
        <mxCell id="ml_layer" parent="drone_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EEF8;strokeColor=#6C3483;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#6C3483;" value="&lt;b&gt;MID-LEVEL LAYER — Decentralized Collision Avoidance&lt;/b&gt;" vertex="1">
          <mxGeometry height="115" width="620" x="18" y="185" as="geometry" />
        </mxCell>

        <!-- Sensor Fusion Block -->
        <mxCell id="fusion" parent="ml_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C3483;strokeWidth=1.5;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#6C3483;" value="&lt;b&gt;Sensor Fusion Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #2C3E50;&quot;&gt;LiDAR Scan &amp;amp; Odometry&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="180" x="60" y="34" as="geometry" />
        </mxCell>

        <!-- ORCA Solver Block -->
        <mxCell id="orca" parent="ml_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C3483;strokeWidth=1.5;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#6C3483;" value="&lt;b&gt;Decentralized ORCA Solver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #2C3E50;&quot;&gt;2D Velocity Obstacle&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="180" x="380" y="34" as="geometry" />
        </mxCell>

        <!-- Arrow Sensor Fusion to ORCA -->
        <mxCell id="edge_fusion_orca" edge="1" parent="ml_layer" source="fusion" style="endArrow=classic;html=1;strokeColor=#6C3483;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#6C3483;" target="orca" value="&lt;i&gt;obstacle profiles&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow High-Level FTCC waypoints to ORCA -->
        <mxCell id="edge_waypoints" edge="1" parent="drone_1" source="ftcc" style="endArrow=classic;html=1;strokeColor=#1A5276;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#1A5276;" target="orca" value="&lt;i&gt;waypoints&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LOW-LEVEL LAYER CONTAINER -->
        <mxCell id="ll_layer" parent="drone_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B9770E;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#B9770E;" value="&lt;b&gt;LOW-LEVEL LAYER — Cascaded PID Robust Control&lt;/b&gt;" vertex="1">
          <mxGeometry height="210" width="620" x="18" y="312" as="geometry" />
        </mxCell>

        <!-- Outer Loop Position Control -->
        <mxCell id="pidhinf" parent="ll_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9770E;strokeWidth=1.5;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#B9770E;" value="&lt;b&gt;Outer Loop: Position Control $$ (x,y,z) $$&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #555555;&quot;&gt;&lt;i&gt;Gain Synthesis: LQR (ARE) vs $$ H_\infty $$ (HARE, $$ \gamma $$)&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="360" x="130" y="34" as="geometry" />
        </mxCell>

        <!-- Inner Loop Attitude Control -->
        <mxCell id="pidlqr" parent="ll_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9770E;strokeWidth=1.5;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#B9770E;" value="&lt;b&gt;Inner Loop: Attitude Control $$ (\phi,\theta,\dot{\psi}) $$&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #555555;&quot;&gt;&lt;i&gt;Gain Synthesis: LQR (ARE) vs $$ H_\infty $$ (HARE, $$ \gamma $$)&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="360" x="130" y="124" as="geometry" />
        </mxCell>

        <!-- Arrow Outer Loop to Inner Loop -->
        <mxCell id="edge_cascade" edge="1" parent="ll_layer" source="pidhinf" style="endArrow=classic;html=1;strokeColor=#B9770E;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#B9770E;" target="pidlqr" value="&lt;i&gt;ref attitude ($$ \phi_{\mathrm{ref}}, \theta_{\mathrm{ref}} $$)&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow ORCA to Outer Loop Position Control -->
        <mxCell id="edge_orca_pidhinf" edge="1" parent="drone_1" source="orca" style="endArrow=classic;html=1;strokeColor=#6C3483;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#6C3483;" target="pidhinf" value="&lt;i&gt;velocity cmd ($$ v_{\mathrm{ref}} $$)&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- P2P DDS MESH NETWORK ARROW -->
        <mxCell id="edge_dds" edge="1" parent="1" source="ftcc" style="endArrow=classic;startArrow=classic;html=1;dashed=1;strokeColor=#1A5276;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#1A5276;" value="&lt;i&gt;P2P DDS Mesh&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- PHYSICAL SIMULATION LAYER CONTAINER -->
        <mxCell id="sim_layer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#117864;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#117864;" value="&lt;b&gt;PHYSICAL SIMULATION ENVIRONMENT — Gazebo Harmonic&lt;/b&gt;" vertex="1">
          <mxGeometry height="95" width="656" x="40" y="650" as="geometry" />
        </mxCell>

        <!-- Quadrotor Plant Block -->
        <mxCell id="plant" parent="sim_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117864;strokeWidth=1.5;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#117864;" value="&lt;b&gt;Quadrotor Dynamics &amp;amp; Plant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #2C3E50;&quot;&gt;PX4 SITL + Gazebo Harmonic Physics&lt;/font&gt;" vertex="1">
          <mxGeometry height="54" width="280" x="180" y="26" as="geometry" />
        </mxCell>

        <!-- Wind Disturbance -->
        <mxCell id="wind" parent="sim_layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#900C3F;fontFamily=Times New Roman,Times,serif;fontSize=9.5;" value="&lt;b&gt;Wind Disturbance&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 8.5px;&quot;&gt;(Dryden Turbulence)&lt;/i&gt;" vertex="1">
          <mxGeometry height="50" width="140" x="480" y="28" as="geometry" />
        </mxCell>

        <mxCell id="edge_wind" edge="1" parent="sim_layer" source="wind" style="endArrow=classic;html=1;strokeColor=#900C3F;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="plant" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow Inner Loop to Plant -->
        <mxCell id="edge_pwm" edge="1" parent="1" source="pidlqr" style="endArrow=classic;html=1;strokeColor=#B9770E;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#B9770E;" target="plant" value="&lt;i&gt;motor RPM / PWM&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- OUTPUT BOX -->
        <mxCell id="output" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontFamily=Times New Roman,Times,serif;fontSize=11;fontColor=#2C3E50;" value="&lt;b&gt;Mission Output:&lt;/b&gt; Coverage $$ \ge 90\% $$, Zero Inter-Robot Collisions, Resilient Fault Recovery" vertex="1">
          <mxGeometry height="36" width="680" x="40" y="760" as="geometry" />
        </mxCell>

        <mxCell id="edge_plant_out" edge="1" parent="1" source="sim_layer" style="endArrow=classic;html=1;strokeColor=#117864;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="output" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_in_drone" edge="1" parent="1" source="input" style="endArrow=classic;html=1;strokeColor=#5D6D7E;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="drone_1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FEEDBACK PATHS (LEFT SIDE) -->
        <!-- Attitude Feedback -->
        <mxCell id="fb_att" edge="1" parent="1" style="endArrow=classic;html=1;dashed=1;strokeColor=#B9770E;strokeWidth=1.5;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#B9770E;" target="pidlqr" value="&lt;i&gt;attitude state&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="687" />
              <mxPoint x="140" y="546" />
            </Array>
            <mxPoint x="240" y="687" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Position Feedback -->
        <mxCell id="fb_pos" edge="1" parent="1" style="endArrow=classic;html=1;dashed=1;strokeColor=#B9770E;strokeWidth=1.5;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#B9770E;" target="pidhinf" value="&lt;i&gt;position state&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="95" y="697" />
              <mxPoint x="95" y="444" />
            </Array>
            <mxPoint x="240" y="697" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- Sensor Feedback to Fusion -->
        <mxCell id="fb_sensor" edge="1" parent="1" style="endArrow=classic;html=1;dashed=1;strokeColor=#6C3483;strokeWidth=1.5;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#6C3483;" target="fusion" value="&lt;i&gt;LiDAR &amp;amp; odom&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="65" y="707" />
              <mxPoint x="65" y="310" />
            </Array>
            <mxPoint x="240" y="707" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- FAULT DETECTION PATH (RIGHT SIDE) -->
        <mxCell id="fb_fault" edge="1" parent="1" style="endArrow=classic;html=1;dashed=1;strokeColor=#1A5276;strokeWidth=1.5;entryX=1;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;fontSize=8.5;fontFamily=Times New Roman,Times,serif;fontColor=#1A5276;" target="ftcc" value="&lt;i&gt;heartbeat loss (fault)&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="687" />
              <mxPoint x="640" y="195" />
            </Array>
            <mxPoint x="480" y="687" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- LEGEND BOX -->
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B2BEC3;strokeWidth=1;fontFamily=Times New Roman,Times,serif;fontSize=9.5;fontColor=#2C3E50;" value="&lt;b&gt;Legend:&lt;/b&gt;   ─── Command Signal     - - - State Feedback     ···· Fault / Heartbeat Loss" vertex="1">
          <mxGeometry height="28" width="480" x="140" y="808" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
