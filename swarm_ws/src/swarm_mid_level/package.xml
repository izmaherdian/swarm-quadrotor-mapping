<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swarm_mid_level</name>
  <version>0.0.0</version>
  <description>Penghindaran tabrakan CBF-QP untuk swarm quadrotor</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache-2.0</license>

  <!-- Library murni numpy/scipy: tidak butuh ROS untuk diuji maupun dipakai.
       Itu yang membuat suite CBF berjalan dalam hitungan detik tanpa Gazebo. -->
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>
  <depend>swarm_low_level</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
