Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Grid 30x30m1
    - /TF Frames1
    - /Mapping_Markers1
    - /🟢 Drone 1 Lidar Scan (Teal)1
    - /🟠 Drone 2 Lidar Scan (Orange)1
    - /🟡 Drone 3 Lidar Scan (Yellow)1
    - /🟢 Drone 4 Lidar Scan (Lime Green)1
    - /🔵 Drone 5 Lidar Scan (Cyan)1
    - /🔵 Drone 6 Lidar Scan (Royal Blue)1
    - /🟣 Drone 7 Lidar Scan (Purple)1
    Splitter Ratio: 0.5
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  # ─── GLOBAL MAPPING & GRIDS ────────────────────────────────
  - Alpha: 0.4
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid 30x30m
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 30
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.35
    Name: TF Frames
    Show Arrows: false
    Show Axes: false
    Show Names: false
    Tree: {}
    Update Interval: 0.05
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Swarm_Reference_Track
    Namespaces:
      ref_track: true
    Queue Size: 100
    Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Reliable
      Value: /swarm_reference_track
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Mapping_Markers
    Namespaces:
      arena_boundary: true
      coverage_footprint: true
      drone_heading_arrows: true
      drone_hubs: true
      drone_reference_carrots: true
      drone_tags: true
      hud_text: true
      merged_dead_cells: true
      north_arrow: true
      planned_paths: true
      planned_waypoints: true
      recovery_paths: true
      sensor_fov: true
      voronoi_cells: true
      voronoi_seeds: true
    Queue Size: 100
    Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Reliable
      Value: /mapping/markers
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Dead_Cells_Markers
    Namespaces:
      dead_cells: true
      merged_dead_cells: true
    Queue Size: 100
    Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Reliable
      Value: /mapping/dead_cells
    Value: true

  # ─── DRONE 1 (TEAL: 0; 190; 165) ───────────────────────────
  - Alpha: 1.0
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 0; 190; 165
    Enabled: true
    Head Diameter: 0.0
    Head Length: 0.0
    Length: 0.0
    Line Style: Lines
    Line Width: 0.03
    Name: 🟢 Drone 1 Actual Path (Teal)
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 0; 190; 165
    Pose Style: 'None'
    Radius: 0.0
    Shaft Diameter: 0.0
    Shaft Length: 0.0
    Topic:
      Depth: 5
      Durability: Volatile
      History: Keep Last
      Reliability: Reliable
      Value: /iris_1/actual_path
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Color: 0; 190; 165
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: 🟢 Drone 1 Lidar Scan (Teal)
    Position Transformer: XYZ
    Queue Size: 10
    Selectable: true
    Size (Pixels): 5
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /iris_1/lidar_scan
    Use Rainbow: false
    Value: true

