Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Grid1
    - /Mapping_Markers1
    - /Planned_Paths1
    - /Drone_1_Actual_Path1
    - /Drone_2_Actual_Path1
    - /Drone_3_Actual_Path1
    - /Drone_4_Actual_Path1
    - /Drone_5_Actual_Path1
    - /Drone_6_Actual_Path1
    - /Drone_7_Actual_Path1
    Splitter Ratio: 0.5
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 34
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Mapping_Markers
    Namespaces: {}
    Queue Size: 100
    Topic:
