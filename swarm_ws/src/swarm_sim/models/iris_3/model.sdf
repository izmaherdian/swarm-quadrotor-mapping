<sdf version="1.9">
  <model name="iris_3">
    <!-- Pose awal dinaikkan ke Z=0.08 agar kaki landing gear bertumpu mulus di tanah -->
    <pose>0 0 0.08 0 0 0</pose>

    <!-- BAGIAN UTAMA (MAIN BODY 3DR IRIS) -->
    <link name="base_link">
      <enable_wind>true</enable_wind>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.50</mass>  <!-- Benchmark 3DR Iris standar PX4 -->
        <inertia>
          <ixx>0.029125</ixx><iyy>0.029125</iyy><izz>0.055225</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      
      <!-- Visual 3D Mesh Asli 3DR Iris -->
      <visual name="body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris_3/meshes/iris.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.95 0.85 0.10 1.0</ambient>
          <diffuse>0.95 0.85 0.10 1.0</diffuse>
        </material>
      </visual>

      <collision name="body_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.47 0.47 0.11</size>
          </box>
        </geometry>
      </collision>

      <!-- VIRTUAL 2D LIDAR SENSOR (Dipasang di Dek Atas z=+0.08m) -->
      <visual name="lidar_mount_visual">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <sensor name='gpu_lidar' type='gpu_lidar'>
        <pose>0 0 0.08 0 0 0</pose>
        <frame_id>iris_3/base_link</frame_id>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.22</min> <!-- Filter self-occlusion bodi/lengan drone -->
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <!-- BALING-BALING 0 (Depan Kanan, Berlawanan Arah Jarum Jam - CCW) -->
    <link name="rotor_0">
      <pose>0.13 -0.22 0.023 0 0 0</pose>
      <inertial><mass>0.005</mass><inertia><ixx>1.25e-05</ixx><iyy>1.25e-05</iyy><izz>2.5e-05</izz></inertia></inertial>
      <visual name="rotor_0_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris_3/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
        <material><ambient>0 0.4 0.9 0.9</ambient><diffuse>0 0.4 0.9 0.9</diffuse></material>
      </visual>
      <collision name="rotor_0_collision">
        <geometry><cylinder><radius>0.128</radius><length>0.005</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <child>rotor_0</child><parent>base_link</parent>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.005</damping><friction>0.01</friction></dynamics></axis>
    </joint>

    <!-- BALING-BALING 1 (Belakang Kiri, Berlawanan Arah Jarum Jam - CCW) -->
    <link name="rotor_1">
      <pose>-0.13 0.20 0.023 0 0 0</pose>
      <inertial><mass>0.005</mass><inertia><ixx>1.25e-05</ixx><iyy>1.25e-05</iyy><izz>2.5e-05</izz></inertia></inertial>
      <visual name="rotor_1_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris_3/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
        <material><ambient>0.2 0.2 0.2 0.8</ambient><diffuse>0.2 0.2 0.2 0.8</diffuse></material>
      </visual>
      <collision name="rotor_1_collision">
        <geometry><cylinder><radius>0.128</radius><length>0.005</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <child>rotor_1</child><parent>base_link</parent>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.005</damping><friction>0.01</friction></dynamics></axis>
    </joint>

    <!-- BALING-BALING 2 (Depan Kiri, Searah Jarum Jam - CW) -->
    <link name="rotor_2">
      <pose>0.13 0.22 0.023 0 0 0</pose>
      <inertial><mass>0.005</mass><inertia><ixx>1.25e-05</ixx><iyy>1.25e-05</iyy><izz>2.5e-05</izz></inertia></inertial>
      <visual name="rotor_2_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris_3/meshes/iris_prop_cw.dae</uri>
          </mesh>
        </geometry>
        <material><ambient>0 0.4 0.9 0.9</ambient><diffuse>0 0.4 0.9 0.9</diffuse></material>
      </visual>
      <collision name="rotor_2_collision">
        <geometry><cylinder><radius>0.128</radius><length>0.005</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <child>rotor_2</child><parent>base_link</parent>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.005</damping><friction>0.01</friction></dynamics></axis>
    </joint>

    <!-- BALING-BALING 3 (Belakang Kanan, Searah Jarum Jam - CW) -->
    <link name="rotor_3">
      <pose>-0.13 -0.20 0.023 0 0 0</pose>
      <inertial><mass>0.005</mass><inertia><ixx>1.25e-05</ixx><iyy>1.25e-05</iyy><izz>2.5e-05</izz></inertia></inertial>
      <visual name="rotor_3_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris_3/meshes/iris_prop_cw.dae</uri>
          </mesh>
        </geometry>
        <material><ambient>0.2 0.2 0.2 0.8</ambient><diffuse>0.2 0.2 0.2 0.8</diffuse></material>
      </visual>
      <collision name="rotor_3_collision">
        <geometry><cylinder><radius>0.128</radius><length>0.005</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <child>rotor_3</child><parent>base_link</parent>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.005</damping><friction>0.01</friction></dynamics></axis>
    </joint>

    <!-- PLUGIN SENSOR: Ground Truth Odometry untuk Akuisisi Data -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>250</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

    <!-- PLUGIN: MOTOR 0 (Front Right - CCW) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp>
      <timeConstantDown>0.02</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <motorType>velocity</motorType>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>0</actuator_number>
      <rotorDragCoefficient>0.000175</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    </plugin>

    <!-- PLUGIN: MOTOR 1 (Rear Left - CCW) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp>
      <timeConstantDown>0.02</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <motorType>velocity</motorType>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>1</actuator_number>
      <rotorDragCoefficient>0.000175</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    </plugin>

    <!-- PLUGIN: MOTOR 2 (Front Left - CW) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp>
      <timeConstantDown>0.02</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <motorType>velocity</motorType>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>2</actuator_number>
      <rotorDragCoefficient>0.000175</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    </plugin>

    <!-- PLUGIN: MOTOR 3 (Rear Right - CW) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp>
      <timeConstantDown>0.02</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <motorType>velocity</motorType>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>3</actuator_number>
      <rotorDragCoefficient>0.000175</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    </plugin>
  </model>
</sdf>
