<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="swarm_world">
    <!-- SPEEDUP SIMULATION: max_step_size=0.001 (1000Hz stable physics) & real_time_factor=0.0 unthrottled -->
    <physics name="fast_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- PLUGIN INTI GAZEBO HARMONIC -->
    <!-- Wajib ada agar gaya gravitasi dan benturan berfungsi -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- PLUGIN ANGIN (WIND EFFECTS) DITUTUP SEMENTARA
    <plugin
      filename="gz-sim-wind-effects-system"
      name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1.0</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <noise type="gaussian">
             <mean>0.0</mean>
             <stddev>3.0</stddev>
          </noise>
        </magnitude>
        <direction>
          <noise type="gaussian">
             <mean>0</mean>
             <stddev>1.0</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
           <mean>0</mean>
           <stddev>1.0</stddev>
        </noise>
      </vertical>
    </plugin>

    <wind>
      <linear_velocity>2.0 2.0 0</linear_velocity>
    </wind>
    -->

    <!-- MATAHARI (SUN) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- LANTAI (GROUND PLANE) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- GUI TOP-VIEW CAMERA PRESET (Z=38m looking down, +Y North UP, +X East RIGHT) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.0 0.0 38.0 0.0 1.5708 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ARENA 30x30m GRID (1m x 1m BLOCKS) & PERIMETER BORDER -->
    <model name="arena_30x30_grid">
      <static>true</static>
      <link name="grid_link">
        <!-- COMPASS NORTH ARROW INDICATOR (+Y) -->
        <visual name="compass_north_arrow">
          <pose>0.0 16.5 0.03 0 0 0</pose>
          <geometry><box><size>0.6 1.8 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="compass_north_tip">
          <pose>0.0 17.6 0.03 0 0 0.7854</pose>
          <geometry><box><size>0.8 0.8 0.04</size></box></geometry>
          <material>
            <ambient>1.0 0.2 0.2 1</ambient>
            <diffuse>1.0 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <!-- COMPASS SOUTH INDICATOR (-Y) -->
        <visual name="compass_south_bar">
          <pose>0.0 -16.5 0.03 0 0 0</pose>
          <geometry><box><size>0.6 1.2 0.04</size></box></geometry>
          <material>
            <ambient>0.2 0.4 0.9 1</ambient>
